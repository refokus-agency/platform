#!/usr/bin/env bash
# Stub `gh` for test-review-context.sh, test-resolve-preview-site.sh and test-resolve-actor.sh:
# answers `gh api ... <path>` from fixture files in $STUB_DIR and logs every call to
# $STUB_DIR/calls.log, so tests can assert on the calls made.
#
# Fixture name: stacks | siblings | head_<head param, every non-alphanumeric as `_`> | graphql
# (any `gh api graphql ...`) | deployments | statuses | pr_comment (`gh pr comment`) | user
# (`users/<login>`) | permission (`repos/.../collaborators/<login>/permission`) | rate_limit.
# It ignores `--jq`: a fixture for a call made with `--jq` holds the filtered value, not the JSON.
# <name>.out is printed (default `[]`, or for graphql a response with no closing issues);
# <name>.rc is the exit code (default 0), and <name>.err the error printed with it (default
# `gh: HTTP <rc>`). <name>.<n>.out, <name>.<n>.rc and <name>.<n>.err, when present, answer the
# n-th call to that name instead, so a test can script a sequence (pending, pending, then
# success; 502, then 200). Each falls back on its own: <name>.<n>.err to <name>.err, then to the
# default. An error file is read only when that call's exit code is non-zero.
# `gh pr comment` also appends its `--body` value to pr_comment.body, one body per call. Like the
# real gh outside a git checkout, which is where the workflow's steps run, it fails unless the
# call names the repository with `--repo` or GH_REPO.
printf '%s\n' "$*" >> "$STUB_DIR/calls.log"
path=""
for a in "$@"; do
  case "$a" in repos/* | users/* | rate_limit) path=$a ;; esac
done
if [ "${1:-}" = api ] && [ "${2:-}" = graphql ]; then
  path=graphql
fi
if [ "${1:-}" = pr ] && [ "${2:-}" = comment ]; then
  case " $* " in
    *" --repo "* | *" -R "*) ;;
    *)
      if [ -z "${GH_REPO:-}" ]; then
        echo "failed to run git: fatal: not a git repository (or any of the parent directories): .git" >&2
        exit 1
      fi
      ;;
  esac
  path=pr_comment
  prev=""
  for a in "$@"; do
    if [ "$prev" = --body ]; then
      printf '%s\n--- end of body ---\n' "$a" >> "$STUB_DIR/pr_comment.body"
    fi
    prev=$a
  done
fi
case "$path" in
  graphql) name=graphql ;;
  pr_comment) name=pr_comment ;;
  */stacks\?*) name=stacks ;;
  */deployments/*/statuses*) name=statuses ;;
  */deployments\?*) name=deployments ;;
  users/*) name=user ;;
  rate_limit) name=rate_limit ;;
  */collaborators/*/permission) name=permission ;;
  */pulls\?*base=*) name=siblings ;;
  */pulls\?*head=*)
    head=${path#*head=}
    head=${head%%&*}
    name="head_$(printf '%s' "$head" | tr -c 'A-Za-z0-9' '_')"
    ;;
  *) echo "stub gh: unexpected call: $*" >&2; exit 99 ;;
esac
n=$(( $(cat "$STUB_DIR/$name.count" 2>/dev/null || echo 0) + 1 ))
printf '%s' "$n" > "$STUB_DIR/$name.count"
if [ -f "$STUB_DIR/$name.$n.out" ]; then
  cat "$STUB_DIR/$name.$n.out"
elif [ -f "$STUB_DIR/$name.out" ]; then
  cat "$STUB_DIR/$name.out"
elif [ "$name" = graphql ]; then
  printf '%s' '{"data":{"repository":{"pullRequest":{"closingIssuesReferences":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}}}}}'
elif [ "$name" = pr_comment ]; then
  :
else
  printf '[]'
fi
rcfile="$STUB_DIR/$name.$n.rc"
[ -f "$rcfile" ] || rcfile="$STUB_DIR/$name.rc"
if [ -f "$rcfile" ]; then
  rc=$(cat "$rcfile")
  if [ "$rc" != 0 ]; then
    errfile="$STUB_DIR/$name.$n.err"
    [ -f "$errfile" ] || errfile="$STUB_DIR/$name.err"
    if [ -f "$errfile" ]; then cat "$errfile" >&2; else echo "gh: HTTP $rc" >&2; fi
  fi
  exit "$rc"
fi
exit 0
